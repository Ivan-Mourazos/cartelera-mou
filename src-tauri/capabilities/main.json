{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Acceso mínimo de la ventana principal a los casos de uso de CineVault.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-scan-folder",
    "allow-validate-ffprobe",
    "allow-list-library",
    "allow-identify-media-file",
    "allow-list-history",
    "allow-get-settings",
    "allow-save-settings",
    "allow-preflight-rename-batch",
    "allow-execute-rename-batch",
    "allow-undo-rename",
    "allow-search-tmdb"
  ]
}
